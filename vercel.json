{
  "rewrites": [
    { "source": "/r/:token", "destination": "/r.html" },
    { "source": "/r", "destination": "/r.html" }
  ],
  "headers": [
    { "source": "/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ],
  "functions": { "api/*.js": { "maxDuration": 60 } }
}
